{
  "name": "code-style",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "check:fmt": "oxfmt . --check",
    "ci:version": "changeset version && pnpm install --lockfile-only",
    "fix:fmt": "oxfmt . --write",
    "fix:lint": "oxlint . --write",
    "check:lint": "oxlint .",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@kazukit/oxfmt-config": "workspace:*",
    "@kazukit/oxlint-config": "workspace:*",
    "@types/node": "^25.9.5",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "pnpm@11.25.0"
}
